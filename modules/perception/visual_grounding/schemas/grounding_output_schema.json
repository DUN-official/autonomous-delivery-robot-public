    "model_name": "string",
    "image_id": "string",
    "image_path": "string",
    "ground_truth_image_path": "string",
    "command_id": "string",
    "prompt": "string",
    "target_label": "string",
    "target_type": "person | package | landmark | door | region | other",
    "bbox_xyxy": {
      "type": "array",
      "description": "Bounding box as [x1, y1, x2, y2] in image pixel coordinates."
